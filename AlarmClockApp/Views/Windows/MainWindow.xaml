<Window x:Class="AlarmClockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AlarmClockApp.ViewModels"
        xmlns:local="clr-namespace:AlarmClockApp"
        mc:Ignorable="d"
        Title="{Binding Path=Title}"
        Height="450" Width="800" Background="#FFF2F3EE" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <vm:MainWindowViewModel x:Key="currentTime" UpdateInterval="00:00:00.100"/>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFF2F3EE"/>
                <GradientStop Color="#FFAFD8D4" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <TabControl>
            <TabItem Header="Clock" BorderBrush="#FFACACAC" Foreground="Black" Background="#FFAFD8D4" FontFamily="Bauhaus 93" FontSize="14" FontWeight="Medium">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFF2F3EE"/>
                            <GradientStop Color="#FFAFD8D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Clock}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 10 0 5" 
                               FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="#F4B4B4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#DC9293"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding Date}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 5 0 10" 
                               FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#F4B4B4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#DC9293"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Timer" BorderBrush="#FFACACAC" Foreground="Black" Background="#FFAFD8D4" FontFamily="Bauhaus 93" FontSize="14" FontWeight="Medium">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFF2F3EE"/>
                            <GradientStop Color="#FFAFD8D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Timer}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 10 0 5" 
                               FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="#F4B4B4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#DC9293"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button Grid.Column="1" Grid.Row="1" Background="Black" BorderBrush="{x:Null}" Margin="5 5 5 10"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Rectangle RadiusX="10" RadiusY="10" Fill="Beige" Height="50" />
                                    <Label Content="Start" FontSize="28" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Grid.Row="1" Background="Black" BorderBrush="{x:Null}" Margin="5 5 5 10"
                            VerticalAlignment="Top" Height="50">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Rectangle RadiusX="10" RadiusY="10" Fill="Beige"/>
                                    <Label Content="Stop" FontSize="28" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="Alarm" BorderBrush="#FFACACAC" Foreground="Black" Background="#FFAFD8D4" FontFamily="Bauhaus 93" FontSize="14" FontWeight="Medium">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFF2F3EE"/>
                            <GradientStop Color="#FFAFD8D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    
                </Grid>

            </TabItem>

        </TabControl>
        
    </Grid>
</Window>
